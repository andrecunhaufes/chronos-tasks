NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://chronos:chronos@localhost:5432/chronos?schema=public&connection_limit=20&pool_timeout=10
REDIS_URL=redis://localhost:6379

# connection_limit e pool_timeout acima vêm de database_connection_pool_size (20)
# e database_query_timeout_seconds (10), definidos no ASSET 23778.

# Gere o par RS256 com:
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

EMAIL_API_KEY=re_troque_por_sua_chave_resend
EMAIL_REMETENTE=nao-responda@chronos.local
APP_URL_BASE=http://localhost:5173

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

SEED_ADMIN_EMAIL=admin@chronos.local
SEED_ADMIN_PASSWORD=Chronos@2026
